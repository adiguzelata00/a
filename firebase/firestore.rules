rules_version = '2';

// Daily leaderboard of Tengri'nin Taşları (mobile app).
// One document per player per day: daily/{date}/scores/{uid}.
// Signed-in (anonymous) players may read a day and write only their own row.
service cloud.firestore {
  match /databases/{database}/documents {
    match /daily/{date}/scores/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(
             ['name', 'floor', 'score', 'won', 'finished', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.floor is int
        && request.resource.data.floor >= 1
        && request.resource.data.floor <= 1000
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.won is bool
        && request.resource.data.finished is bool
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
